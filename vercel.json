



{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "bindings": [
    {
      "type": "service",
      "service": "inventory",
      "format": "url",
      "env": "INVENTORY_URL"
    }
  ]
}
  